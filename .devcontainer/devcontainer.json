{
  "name": "AL Wafi — Laravel + PostgreSQL",
  "dockerComposeFile": "docker-compose.yml",
  "service": "app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "22" }
  },

  // Dijalankan sekali saat codespace dibuat: pasang dependensi, bangun aset,
  // migrasi, dan isi data awal (termasuk pengguna admin).
  "postCreateCommand": "bash .devcontainer/setup.sh",

  // Dijalankan tiap codespace dinyalakan: hidupkan servernya di latar belakang.
  "postStartCommand": "bash .devcontainer/start-server.sh",

  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Aplikasi AL Wafi",
      "onAutoForward": "openPreview"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "bmewburn.vscode-intelephense-client",
        "onecentlin.laravel-blade"
      ]
    }
  }
}
